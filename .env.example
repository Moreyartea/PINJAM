# PINJAM Frontend Environment Variables
# Never put server-side secrets or service-role keys in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_APP_NAME=PINJAM
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

# Mock mode is strictly for local development before the backend is ready.
# In production, mock mode is always disabled regardless of this flag.
NEXT_PUBLIC_USE_MOCK_API=true

# Supabase Public Configuration (safe for browser & SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alternative if your Supabase project uses a publishable key instead of anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_ or expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
QR_TOKEN_SECRET=
